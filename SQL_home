19. **top_2009_agent.sql**

    * **Original:** Which sales agent made the most in sales in 2009?
      Hint: Use the MAX function on a subquery.
    * **한글 해석:** 2009년에 가장 많은 매출을 올린 Sales Agent를 조회하는 쿼리를 작성하시오.
      힌트: 서브쿼리에서 MAX 함수를 사용하시오.
===============
SELECT 
    e.FirstName || ' ' || e.LastName AS SalesAgent,
    SUM(i.Total) AS TotalSales
FROM employees e
JOIN customers c 
    ON e.EmployeeId = c.SupportRepId
JOIN invoices i 
    ON c.CustomerId = i.CustomerId
WHERE e.Title LIKE '%Sales%'
  AND e.Title LIKE '%Agent%'
  AND strftime('%Y', i.InvoiceDate) = '2009'
GROUP BY e.EmployeeId
HAVING SUM(i.Total) = (
    SELECT MAX(SalesSum)
    FROM (
        SELECT SUM(i2.Total) AS SalesSum
        FROM employees e2
        JOIN customers c2 
            ON e2.EmployeeId = c2.SupportRepId
        JOIN invoices i2 
            ON c2.CustomerId = i2.CustomerId
        WHERE e2.Title LIKE '%Sales%'
          AND e2.Title LIKE '%Agent%'
          AND strftime('%Y', i2.InvoiceDate) = '2009'
        GROUP BY e2.EmployeeId
    )
);
=========================
SELECT 
    e.FirstName || ' ' || e.LastName AS SalesAgent,
    SUM(i.Total) AS TotalSales
FROM employees e
JOIN customers c ON e.EmployeeId = c.SupportRepId
JOIN invoices i ON c.CustomerId = i.CustomerId
WHERE e.Title LIKE '%Sales%'
  AND e.Title LIKE '%Agent%'
  AND strftime('%Y', i.InvoiceDate) = '2009'
GROUP BY e.EmployeeId
ORDER BY TotalSales DESC
LIMIT 1;
=======================

