FROM Invoice Country = Brazil

SELECT firstname ||" "|| lastname AS fullname, invoiceid, invoicedate, 청구국가

고객(customers) 테이블과 영수증(invoice) JOIN

customers.customerid=invoice.customerid
SELECT firstname ||" "|| lastname AS fullname, i.invoiceid, i.invoicedate, i.billingcountry FROM customers c JOIN invoices i ON c.customerid=i.customerid WHERE c.country = 'Brazil'
